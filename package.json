{
  "name": "playwright-cucumber-framework",
  "version": "1.0.0",
  "description": "Production-grade Playwright Cucumber Automation Framework",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "cucumber-js --import src/steps/**/*.js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "test:chrome": "$env:BROWSER='chromium'; cucumber-js --import src/steps/**/*.js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "test:firefox": "$env:BROWSER='firefox'; cucumber-js --import src/steps/**/*.js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "test:webkit": "$env:BROWSER='webkit'; cucumber-js --import src/steps/**/*.js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "test:headed": "cross-env HEADED=true cucumber-js --import src/steps/**/*.js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "test:debug": "$env:DEBUG='true'; cucumber-js --import src/steps/**/*.js --format progress-bar --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "test:report": "npm run test && npm run open:report",
    "test:generate-report": "npm run test",
    "open:report": "node scripts/openReport.js",
    "test:with-report": "npm run test && npm run open:report",
    "scenarios:generate": "node scripts/generateScenarios.js --generate-only",
    "scenarios:run": "node scripts/generateScenarios.js",
    "setup": "node scripts/createSampleData.js && node scripts/createScenarioBuilder.js",
    "lint": "eslint src/",
    "format": "prettier --write src/ features/"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@playwright/test": "^1.45.0",
    "playwright": "^1.45.0",
    "exceljs": "^4.4.0",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0",
    "dayjs": "^1.11.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "automation",
    "testing",
    "bdd"
  ],
  "author": "",
  "license": "MIT"
}
